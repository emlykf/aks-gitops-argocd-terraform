# Terraform State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore override files as they are usually local and not shared
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore files generated by Terraform
.terraform/
#.terraform.lock.hcl

# Ignore Terraform plan files
*.tfplan

# Ignore logs from Terraform commands
*.log

# Ignore sensitive variable files
*.tfvars
*.tfvars.json

# Ignore backups of Terraform files
*.tf.backup

# SSH Keys
*.pem

# Backup files
*.bak

# Sensitive files
*.key